# ==========================================
# Local LLM Service (Ollama / OpenAI-Compatible)
# ==========================================
# In Docker on Windows/Mac, use http://host.docker.internal:11434/v1
# On bare metal Linux or direct host execution, use http://localhost:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL_NAME=ollama/llama3
OPENAI_API_KEY=NA

# ==========================================
# Syllabus REST API Configuration
# ==========================================
SYLLABUS_API_BASE_URL=https://api.youruniversity.edu/v1
SYLLABUS_API_TOKEN=your_bearer_token_here
MOCK_SYLLABUS=true

# ==========================================
# Output Volume Directory
# ==========================================
OUTPUT_DIR=output
